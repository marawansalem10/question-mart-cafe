# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# IMPORTANT: Set this to your MongoDB connection string.
# Local example:
MONGODB_URI=mongodb://localhost:27017/questionmartcafe
# Atlas format (do not commit real credentials):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRE=30d

# CORS — required when NODE_ENV=production
# Comma-separated list of frontend origins (customer and admin).
# Example for local frontends:
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Production: set this in the host environment to the deployed frontend origins.
# Do not use * in production.
