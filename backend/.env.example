# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# IMPORTANT: Change this to your actual MongoDB connection string
# Format: mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/questionmartcafe

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRE=30d
